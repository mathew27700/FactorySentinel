POSTGRES_USER=factorysentinel
POSTGRES_PASSWORD=change_me
POSTGRES_DB=factorysentinel
KAFKA_BOOTSTRAP=kafka:9092
GRAFANA_ADMIN_PASSWORD=change_me
AIRFLOW_ADMIN_PASSWORD=change_me

# Simulator: 3600 = one dataset hour per real second. The stream starts where the history ends.
SIM_SPEED=3600
SIM_START=2015-07-01
SIM_MAX_HOURS=0

# Spark: local[2] runs the job inside one container. See docs/decisions/003-spark-mode.md.
SPARK_MASTER=local[2]
