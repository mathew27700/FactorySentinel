            "uid": "postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT created_at AS raised, machine_id AS machine, rule, round(value::numeric, 1) AS value,\n       threshold, event_time AS dataset_time\nFROM alerts WHERE scope = 'reading' ORDER BY created_at DESC LIMIT 12"
