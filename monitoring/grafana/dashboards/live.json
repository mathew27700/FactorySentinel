            "uid": "postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ingest_time AS \"time\", 'machine ' || machine_id AS metric, volt AS value\nFROM live_readings\nWHERE $__timeFilter(ingest_time) AND machine_id IN ($machine)\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
