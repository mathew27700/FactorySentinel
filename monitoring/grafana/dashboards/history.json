      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT date_trunc('month', failed_at, 'UTC') AS \"time\", component AS metric, count(*) AS value\nFROM fact_failure WHERE $__timeFilter(failed_at)\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
