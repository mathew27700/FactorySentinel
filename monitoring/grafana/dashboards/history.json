        "name": "machine",
        "label": "Machine",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "postgres"
        },
        "query": "SELECT generate_series(1, 100)",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "sort": 3,
        "current": {
          "text": "1",
          "value": "1",
          "selected": true
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Recorded failures",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "postgres"
        },
        "enable": true,
        "iconColor": "red",
        "target": {
          "refId": "Anno",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT f.failed_at AS \"time\", 'FAILURE ' || f.component AS text\nFROM fact_failure f JOIN dim_machine m USING (machine_key)\nWHERE m.machine_id = $machine AND $__timeFilter(f.failed_at)"
        },
        "mappings": {
          "time": {
            "source": "field",
            "value": "time"
          },
          "text": {
            "source": "field",
            "value": "text"
          }
        }
      },
      {
        "name": "24-hour alerts",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "postgres"
        },
        "enable": true,
        "iconColor": "orange",
        "target": {
          "refId": "Anno",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT event_time AS \"time\", rule AS text FROM alerts\nWHERE scope = 'day' AND machine_id = $machine AND $__timeFilter(event_time)"
        },
        "mappings": {
          "time": {
            "source": "field",
            "value": "time"
          },
          "text": {
            "source": "field",
            "value": "text"
          }
        }
      }
    ]
  },
