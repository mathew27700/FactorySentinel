    {
      "id": 9,
      "type": "timeseries",
      "title": "Recorded failures per month, by component",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
