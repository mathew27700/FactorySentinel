    {
      "id": 5,
      "type": "timeseries",
      "title": "Daily average voltage, machine $machine",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT d.full_date::timestamptz AS \"time\", f.avg_volt AS \"avg_volt\"\nFROM fact_machine_day f\nJOIN dim_machine m USING (machine_key)\nJOIN dim_date d USING (date_key)\nWHERE m.machine_id = $machine AND $__timeFilter(d.full_date::timestamptz)\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
